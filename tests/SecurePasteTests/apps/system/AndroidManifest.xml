<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="grapheneos.securepaste.system">

    <permission
        android:name="grapheneos.securepaste.system.permission.COMMAND"
        android:protectionLevel="signature" />

    <application
        android:debuggable="true"
        android:label="Secure Paste System"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name="grapheneos.securepaste.helper.SecurePasteActivity"
            android:exported="true" />
        <provider
            android:name="grapheneos.securepaste.helper.SecurePasteCommandProvider"
            android:authorities="grapheneos.securepaste.system.provider"
            android:exported="true"
            android:permission="grapheneos.securepaste.system.permission.COMMAND" />
    </application>
</manifest>
