<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="app.grapheneos.hardeningtest">

    <!--   Since there are multiple versions of HardeningTest, permission name of -->
    <!--   dynamic receiver not exported checks conflicts between them. -->
    <!--   Remove this permission, it doesn't affect the testing app's functionality. -->
    <permission android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <application
        android:debuggable="true"
        android:zygotePreloadName="app.grapheneos.hardeningtest.ZygotePreloadImpl" >

        <uses-library android:name="android.test.runner" />

        <service
            android:name=".TestService"
            android:process=":test"
            android:exported="false" />

        <service
            android:name=".IsolatedTestService"
            android:isolatedProcess="true"
            android:useAppZygote="true"
            android:exported="false" />

        <service
            android:name=".IsolatedNativeTestService"
            android:isolatedProcess="true"
            android:nativeService="true"
            android:exported="false">
            <property android:name="android.app.PROPERTY_NATIVE_SERVICE_LIBRARY_NAME"
                android:value="libhardening_test.so" />
        </service>

	<!--   Since there are multiple versions of HardeningTest, authority value of androidx InitializationProvider -->
	<!--   conflicts between them.-->
	<!--   Remove this provider, it doesn't affect app's functionality.-->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />

    </application>

    <instrumentation
        android:name="androidx.test.runner.AndroidJUnitRunner"
        android:targetPackage="${applicationId}" />

</manifest>
